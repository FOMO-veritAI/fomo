# Copie para .env (o criar_env.py faz isso e gera as chaves). O .env nunca vai para o git.

# Domínio apontando para esta máquina: o Caddy obtém o certificado HTTPS sozinho (portas 80 e 443 abertas).
# Para testar na própria máquina, sem HTTPS: http://localhost
DOMINIO=fomo.exemplo.com.br

# Chaves das telas Publisher e Revisão (compartilhadas, como no MVP local).
TAKTA_PUBLISHER_KEY=
TAKTA_REVIEWER_KEY=

# v1: melhor nos testes, cerca de 3,6 GB de RAM no pico; v0: cerca de 2,2 GB e mais rápida em CPU.
VERITAI_PERFIL=v1

# Ligada, manda termos de notícias ainda não publicadas ao Bing e ao GDELT. Decisão do grupo (W12).
VERITAI_BUSCAR_WEB=false

# Só se o frontend ficar em outra origem, como o GitHub Pages: https://fomo-veritai.github.io
FOMO_CORS_ORIGINS=

# Opcional: lista checagens anteriores do Google Fact Check (só informam, nunca decidem).
GOOGLE_FACT_CHECK_API_KEY=

# Portas publicadas nesta máquina.
PORTA_HTTP=80
PORTA_HTTPS=443
